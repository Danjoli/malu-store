APP_NAME="Malu Store - Homologação"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.malu-store.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# O nome precisa conter "staging" para o deploy aceitar este banco.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=malu_store_staging
DB_USERNAME=
DB_PASSWORD=

# Use um banco/projeto Redis que não seja o de produção.
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=240
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.staging.malu-store.com
SESSION_SERIALIZATION=json
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_PREFIX=malu-store-staging-
REDIS_CACHE_DB=1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
# O nome precisa conter "staging" e apontar para um bucket exclusivo.
AWS_BUCKET=malu-store-staging
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Não envie e-mails reais a partir da homologação.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=homologacao@malu-store.com
MAIL_FROM_NAME="Malu Store - Homologação"

ALERT_EMAIL=
ALERT_QUEUE_DELAY_SECONDS=600
ALERT_QUEUE_PENDING_JOBS=100
ALERT_QUEUE_NAMES=critical,default
ALERT_THROTTLE_MINUTES=60
CATALOG_CACHE_SECONDS=60

# Credenciais exclusivas para abrir o site de homologação no navegador.
STAGING_BASIC_AUTH_USERNAME=
STAGING_BASIC_AUTH_PASSWORD=

# Integrações reais são bloqueadas neste ambiente.
ASAAS_ENV=sandbox
ASAAS_SANDBOX_API_KEY=
ASAAS_SANDBOX_WEBHOOK_TOKEN=
ASAAS_SANDBOX_BASE_URL=https://api-sandbox.asaas.com/v3

MELHOR_ENVIO_ENV=sandbox
MELHOR_ENVIO_SANDBOX_TOKEN=
MELHOR_ENVIO_SANDBOX_BASE_URL=https://sandbox.melhorenvio.com.br/api/v2/me/
MELHOR_ENVIO_SANDBOX_WEBHOOK_SECRET=
MELHOR_ENVIO_ORIGIN_ZIP=01001000
MELHOR_ENVIO_SENDER_NAME="Malu Store - Homologação"
MELHOR_ENVIO_SENDER_EMAIL=homologacao@malu-store.com
MELHOR_ENVIO_SENDER_PHONE=
MELHOR_ENVIO_SENDER_DOCUMENT=
MELHOR_ENVIO_SENDER_ADDRESS=
MELHOR_ENVIO_SENDER_NUMBER=
MELHOR_ENVIO_SENDER_DISTRICT=
MELHOR_ENVIO_SENDER_CITY=
MELHOR_ENVIO_SENDER_STATE=SP

# Pode usar o mesmo projeto Sentry, mas sempre com environment=staging.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false
SENTRY_ENABLE_LOGS=false
SENTRY_ENABLE_METRICS=false

SECURITY_HSTS=true
SECURITY_HSTS_MAX_AGE=31536000
VITE_APP_NAME="${APP_NAME}"
