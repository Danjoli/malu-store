APP_NAME="Malu Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=malu_store
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_SERIALIZATION=json

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=120
QUEUE_FAILED_DRIVER=database-uuids

SECURITY_HSTS=true
SECURITY_HSTS_MAX_AGE=31536000

CACHE_STORE=database
CATALOG_CACHE_SECONDS=60
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="${APP_NAME}"
# Destinatário opcional de falhas críticas de operação.
ALERT_EMAIL=
ALERT_QUEUE_DELAY_SECONDS=600
ALERT_QUEUE_PENDING_JOBS=100
ALERT_QUEUE_NAMES=critical,default
ALERT_THROTTLE_MINUTES=60

# Integrações de pagamento e frete. Use apenas sandbox ou production.
# Para mudar de ambiente, altere as duas variáveis abaixo; não comente URLs.
ASAAS_ENV=sandbox
ASAAS_SANDBOX_API_KEY=
ASAAS_SANDBOX_WEBHOOK_TOKEN=
ASAAS_SANDBOX_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_PRODUCTION_API_KEY=
ASAAS_PRODUCTION_WEBHOOK_TOKEN=
ASAAS_PRODUCTION_BASE_URL=https://api.asaas.com/v3
ASAAS_USER_AGENT="${APP_NAME}/1.0 (${ASAAS_ENV})"

MELHOR_ENVIO_ENV=sandbox
MELHOR_ENVIO_SANDBOX_TOKEN=
MELHOR_ENVIO_SANDBOX_BASE_URL=https://sandbox.melhorenvio.com.br/api/v2/me/
MELHOR_ENVIO_SANDBOX_WEBHOOK_SECRET=
MELHOR_ENVIO_PRODUCTION_TOKEN=
MELHOR_ENVIO_PRODUCTION_BASE_URL=https://melhorenvio.com.br/api/v2/me/
MELHOR_ENVIO_PRODUCTION_WEBHOOK_SECRET=

# CEP usado como origem nas cotações e na emissão de etiquetas.
MELHOR_ENVIO_ORIGIN_ZIP=01001000
# Dados do remetente obrigatórios para gerar etiquetas. Não inclua valores reais no Git.
MELHOR_ENVIO_SENDER_NAME="${APP_NAME}"
MELHOR_ENVIO_SENDER_PHONE=
MELHOR_ENVIO_SENDER_EMAIL="${MAIL_FROM_ADDRESS}"
MELHOR_ENVIO_SENDER_DOCUMENT=
MELHOR_ENVIO_SENDER_ADDRESS=
MELHOR_ENVIO_SENDER_NUMBER=
MELHOR_ENVIO_SENDER_DISTRICT=
MELHOR_ENVIO_SENDER_CITY=
MELHOR_ENVIO_SENDER_STATE=SP
MELHOR_ENVIO_USER_AGENT="${APP_NAME} (${MAIL_FROM_ADDRESS})"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Monitoramento de erros e desempenho. A DSN deve existir apenas no ambiente.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false
SENTRY_ENABLE_LOGS=false
SENTRY_ENABLE_METRICS=false

VITE_APP_NAME="${APP_NAME}"
